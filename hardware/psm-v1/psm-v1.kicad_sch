  (text "PSM V1 - CONNECTION-LEVEL SCHEMATIC (thesis baseline)"
    (at 60 40 0)
    (effects (font (size 4.0 4.0)) (justify left))
    (uuid cd216239-91e7-4fdd-901c-68d0502a8675)
  )
  (text "16x VCNL4020 on 4x4 array; 2x PCA9548A; Tiva/LaunchPad header. PCB is authoritative for passives and routing."
    (at 60 52 0)
    (effects (font (size 2.0 2.0)) (justify left))
    (uuid 372b74ac-30cc-4ec4-b5e5-c39e94b38a2f)
  )
  (text "Per sensor: 100nF local decoupling, 10R IR-anode series resistor. 22uF bulk per mux/header."
    (at 60 62 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid 28e2912c-256c-4fdd-a1f5-03944d86009c)
  )
  (text "U17 channels 0-7 -> U1..U8; U18 channels 0-7 -> U9..U16."
    (at 60 520 0)
    (effects (font (size 2.0 2.0)) (justify left))
    (uuid a12e806b-44d7-4b7e-b079-52430f548c28)
  )
  (text "VCNL4020: 1 IR anode, 2 SDA, 3 INT, 4 SCL, 5 VDD, 8/9 GND, 6/7/10 NC."
    (at 60 532 0)
    (effects (font (size 1.7 1.7)) (justify left))
    (uuid 5b1ff265-17ee-42cc-ba7e-eec76645dda3)
  )

