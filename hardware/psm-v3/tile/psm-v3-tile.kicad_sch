    (uuid 9a15e2bc-1f82-4d6c-b795-8d7278018cb6)
  )
  (text "J1: 1=3V3 2=GND 3=SDA 4=SCL 5=INT_N 6=NC. Sealing ring and conformal coat are PCB-level."
